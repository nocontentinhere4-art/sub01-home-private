out/rest/rejected/
out/rest/*.part.npz

# secrets (API keys) never go to git
.env
.env.*
out/anatomy_work/
# the window plates' photographic sources (~120 MB): room_build/window_cards.py --fetch re-downloads them
room_build/plates/

# visual QA harness (tests/visual): screenshots and the CDN cache are never committed
tests/visual/out/
tests/visual/.cdn_cache/

# Local home geometry export for offline baking
out/home-bake-source.png

# Guest binaries: bootstrap verifies/downloads official upstream versions.
computer/*.bin

node_modules/
/node_modules

