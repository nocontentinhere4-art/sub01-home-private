+def log_after(path, offset, marker):
+    """m5: the first line holding `marker` after byte `offset` (this launch's part of an appended log), or None."""
+    try:
+        with open(path, 'rb') as handle:
+            handle.seek(offset)
+            for raw in handle:
+                line = raw.decode('utf-8', 'replace')
+                if marker in line:
+                    return line.strip()[:600]
+    except OSError:
+        return None
+    return None
