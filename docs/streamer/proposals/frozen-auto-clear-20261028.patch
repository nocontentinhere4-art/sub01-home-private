@@ -4008,3 +4008,27 @@ def test_poll_counts_real_answers_and_reports_them_once(tmp_path):
     assert agent.poll is None and any(e["kind"] == "poll_refused" for e in events(agent))
     clock.t += SA.POLL_RESULT_S
